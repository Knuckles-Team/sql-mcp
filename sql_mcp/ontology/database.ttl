@prefix fibo-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-org: <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/Organizations/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix : <http://knuckles.team/kg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:dataType a owl:DatatypeProperty ;
    rdfs:label "data type" ;
    rdfs:comment "The relational SQL data type of the column (e.g., VARCHAR, INTEGER, TIMESTAMP)." ;
    rdfs:domain :DatabaseColumn ;
    rdfs:range xsd:string .

:hasColumn a owl:ObjectProperty ;
    rdfs:label "has column" ;
    rdfs:comment "Links a database table to its constituent columns." ;
    rdfs:domain :DatabaseTable ;
    rdfs:range :DatabaseColumn .

:hasTable a owl:ObjectProperty ;
    rdfs:label "has table" ;
    rdfs:comment "Links a database schema to its constituent tables." ;
    rdfs:domain :DatabaseSchema ;
    rdfs:range :DatabaseTable .

:isForeignKey a owl:DatatypeProperty ;
    rdfs:label "is foreign key" ;
    rdfs:comment "Boolean flag indicating if this column is part of a foreign key." ;
    rdfs:domain :DatabaseColumn ;
    rdfs:range xsd:boolean .

:isNullable a owl:DatatypeProperty ;
    rdfs:label "is nullable" ;
    rdfs:comment "Boolean flag indicating if the column accepts NULL values." ;
    rdfs:domain :DatabaseColumn ;
    rdfs:range xsd:boolean .

:isPrimaryKey a owl:DatatypeProperty ;
    rdfs:label "is primary key" ;
    rdfs:comment "Boolean flag indicating if this column is part of the primary key." ;
    rdfs:domain :DatabaseColumn ;
    rdfs:range xsd:boolean .

:references a owl:ObjectProperty ;
    rdfs:label "references" ;
    rdfs:comment "Links a database view to a table it selects from (CONCEPT:KG-2.212)." ;
    rdfs:domain :DatabaseView ;
    rdfs:range :DatabaseTable .

:referencesColumn a owl:ObjectProperty ;
    rdfs:label "references column" ;
    rdfs:comment "Links a column to another column via foreign key relationship." ;
    rdfs:domain :DatabaseColumn ;
    rdfs:range :DatabaseColumn .

:referencesTable a owl:ObjectProperty ;
    rdfs:label "references table" ;
    rdfs:comment "Links a table to another table via foreign key relationship." ;
    rdfs:domain :DatabaseTable ;
    rdfs:range :DatabaseTable .

<http://knuckles.team/kg/database> a owl:Ontology ;
    rdfs:label "Relational Database Schema Ontology" ;
    rdfs:comment """Ontology for modeling relational database schemas, tables, columns,
and keys. This maps database artifacts to logical Data Objects at the
ArchiMate Application/Technology layer, allowing code generators and
planners to dynamically reason about data layouts.""" ;
    owl:imports <http://knuckles.team/kg/enterprise> .

:DatabaseSchema a owl:Class ;
    rdfs:label "Database Schema" ;
    rdfs:comment "A logical grouping of database tables and relations." ;
    rdfs:subClassOf :TechnologyLayer .

:DatabaseView a owl:Class ;
    rdfs:label "Database View" ;
    rdfs:comment "A SQL view (a named query over one or more tables). Extracted from CREATE VIEW DDL (CONCEPT:KG-2.212); its source tables are linked by :references." ;
    rdfs:subClassOf :ApplicationLayer .

:DatabaseTable a owl:Class ;
    rdfs:label "Database Table" ;
    rdfs:comment "A database table representing a logical data object." ;
    rdfs:subClassOf :ApplicationLayer .

:DatabaseColumn a owl:Class ;
    rdfs:label "Database Column" ;
    rdfs:comment "An individual column within a database table." ;
    rdfs:subClassOf :ApplicationLayer .

:DatabaseIndex a owl:Class ;
    rdfs:label "Database Index" ;
    rdfs:comment "A named index over one or more columns of a table (unique or non-unique), reflected from the live schema (CONCEPT:AU-KG.ingest.enterprise-source-extractor)." ;
    rdfs:subClassOf :ApplicationLayer .

:hasIndex a owl:ObjectProperty ;
    rdfs:label "has index" ;
    rdfs:comment "Links a database table to an index defined over its columns." ;
    rdfs:domain :DatabaseTable ;
    rdfs:range :DatabaseIndex .

:hasView a owl:ObjectProperty ;
    rdfs:label "has view" ;
    rdfs:comment "Links a database schema to a view it contains." ;
    rdfs:domain :DatabaseSchema ;
    rdfs:range :DatabaseView .

:isUnique a owl:DatatypeProperty ;
    rdfs:label "is unique" ;
    rdfs:comment "Boolean flag indicating whether an index enforces uniqueness." ;
    rdfs:domain :DatabaseIndex ;
    rdfs:range xsd:boolean .

:sqlDialect a owl:DatatypeProperty ;
    rdfs:label "sql dialect" ;
    rdfs:comment "The SQL dialect of the connection the artifact was reflected from (e.g., postgres, mysql, sqlite, trino, duckdb)." ;
    rdfs:domain :DatabaseSchema ;
    rdfs:range xsd:string .

:TrinoCatalog a owl:Class ;
    rdfs:label "Trino Catalog" ;
    rdfs:comment "A Trino catalog (a configured connector instance, e.g. an Iceberg lakehouse or a JDBC federation target), discovered via SHOW CATALOGS (CA-41)." ;
    rdfs:subClassOf :TechnologyLayer .

:TrinoQuery a owl:Class ;
    rdfs:label "Trino Query" ;
    rdfs:comment "One observed Trino query from system.runtime.queries — query id, submitting user, lifecycle state, and creation time (CA-41)." ;
    rdfs:subClassOf :ApplicationLayer .

:DuckDbAttachment a owl:Class ;
    rdfs:label "DuckDB Iceberg Attachment" ;
    rdfs:comment "One DuckDB session's ATTACH of an Iceberg REST catalog (Lakekeeper-shaped): the alias, warehouse, and REST endpoint it was attached with (CA-41)." ;
    rdfs:subClassOf :TechnologyLayer .

:hasSchema a owl:ObjectProperty ;
    rdfs:label "has schema" ;
    rdfs:comment "Links a Trino catalog to a schema (namespace) it exposes (CA-41)." ;
    rdfs:domain :TrinoCatalog ;
    rdfs:range :DatabaseSchema .

:queriedTable a owl:ObjectProperty ;
    rdfs:label "queried table" ;
    rdfs:comment "Links an observed Trino query to a table it referenced, where resolvable (CA-41)." ;
    rdfs:domain :TrinoQuery ;
    rdfs:range :DatabaseTable .

:attachesTable a owl:ObjectProperty ;
    rdfs:label "attaches table" ;
    rdfs:comment "Links a DuckDB Iceberg attachment to a table it exposes through the attached REST catalog (CA-41)." ;
    rdfs:domain :DuckDbAttachment ;
    rdfs:range :DatabaseTable .
